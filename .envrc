strict_env

watch_file flake.nix flake.lock Cargo.toml Cargo.lock
watch_dir nix
# Watched even while absent, so a later sibling checkout triggers a reload.
watch_file ../nix-opencode-lsp/lib/default.nix ../nix-opencode-lsp/flake.nix ../nix-opencode-lsp/flake.lock
nix_direnv_disallow_fallback
# Worktrees may not have the optional sibling language-server checkout.
if test -f ../nix-opencode-lsp/flake.nix; then
  # Separate cache layout; loaded first so the native shell below wins.
  lsp_root="$(cd -P ../nix-opencode-lsp && pwd -P)"
  direnv_layout_dir="$(direnv_layout_dir)/opencode-lsp" use flake "git+file://$lsp_root#opencode-lsp" --no-update-lock-file || return 1
  unset lsp_root
  # Drop that layout's reload helper: workers must not inherit provider-local PATH.
  PATH_rm "$(direnv_layout_dir)/opencode-lsp/bin"
fi
use flake "git+file://$PWD" --no-update-lock-file || return 1
export PROJECT_DEV_SHELL_ACTIVE=default
