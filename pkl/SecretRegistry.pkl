/// Reusable schema for secret-manager data registries.
///
/// Data repositories may amend this module or import its classes from their
/// own Pkl files. Keep fields additive: Rust and Nix consumers treat omitted
/// optional fields as disabled features.

class Source {
  kind: String
  user: String? = null
  name: String
  relative: String? = null
}

class GithubEnvironment {
  repository: String
  environment: String
}

/// A Kubernetes Secret written with `kubectl apply --server-side`.
/// `opaque` uses `key` (default: the target `name`); `dockerconfigjson`
/// requires `username` and may set `registry`.
class KubernetesDestination {
  context: String
  namespace: String
  secret: String
  format: String(this == "opaque" || this == "dockerconfigjson")
  key: String? = null
  registry: String? = null
  username: String? = null
  fieldManager: String? = null
}

class SyncTarget {
  target: String
  name: String
  codebergUser: Boolean = false
  codeberg: Listing<String>? = null
  codefloe: Listing<String>? = null
  github: Listing<String>? = null
  githubEnvironments: Listing<GithubEnvironment>? = null
  kubernetes: Listing<KubernetesDestination>? = null
  codebergOrgs: Listing<String>? = null
  host: String = "codeberg.org"
}

class RunnerFileEnvTarget {
  env: String
  instances: Listing<String>
}

class EncryptedSecret {
  source: Source
  env: Listing<String> = new {}
  sync: SyncTarget? = null
  runnerFileEnv: Listing<RunnerFileEnvTarget> = new {}
  dockerRegistry: String? = null
  coprFile: String? = null
}

class PlainSecret {
  source: String
  value: String
  sync: SyncTarget? = null
}

class EnvRegistry {
  encrypted: Mapping<String, EncryptedSecret> = new {}
  plain: Mapping<String, PlainSecret> = new {}
}

/// One credential account: a host-scoped agenix source.
class Account {
  sourceHost: String
  secretName: String
}

/// Several accounts for one credential service, and the fleet default.
/// (`default` itself would collide with Mapping's default-element member.)
class AccountService {
  defaultAccount: String
  accounts: Mapping<String, Account>
}

/// A host's credential users and its service -> account overrides.
class AccountHost {
  users: Listing<String> = new {}
  accounts: Mapping<String, String> = new {}
}

/// Switchable service accounts, decoded by the `caniko-secret-manager-schema`
/// crate. A user on a host receives the host override, else the user
/// override, else the service's default account.
class AccountCatalogue {
  services: Mapping<String, AccountService>
  hosts: Mapping<String, AccountHost> = new {}
  users: Mapping<String, Mapping<String, String>> = new {}
}

/// How to replace one credential by hand. Identity and instructions only;
/// never a value or ciphertext. The `secret` path names the encrypted source.
class RotationGuide {
  /// Short human title of the credential.
  title: String
  /// Store-relative path of the encrypted source, when the credential is one.
  secret: String? = null
  /// Provider pages where the new value is minted, opened in order.
  urls: Listing<String(startsWith("https://"))> = new {}
  /// What the operator does, in order.
  steps: Listing<String> = new {}
  /// Command that stores the new value, shown after the steps.
  command: String? = null
  cadenceDays: Int(isPositive)? = null
  warnDays: Int(this >= 0)? = null
}

/// Manual rotation instructions, keyed by credential slug.
class RotationCatalogue {
  guides: Mapping<String(matches(Regex(#"^[a-z0-9][a-z0-9._-]*$"#))), RotationGuide> = new {}
}

scopes: Mapping<String, EnvRegistry> = new {}

canPersonalPcEnv: EnvRegistry? = null
sharedPersonalPcEnv: EnvRegistry? = null
