/// Reusable schema for secret-manager data registries.
///
/// Data repositories may amend this module or import its classes from their
/// own Pkl files. Keep fields additive: Rust and Nix consumers treat omitted
/// optional fields as disabled features.

class Source {
  kind: String
  user: String? = null
  name: String
  relative: String? = null
}

class SyncTarget {
  target: String
  name: String
  codebergUser: Boolean = false
  codeberg: Listing<String>? = null
  codefloe: Listing<String>? = null
  github: Listing<String>? = null
  codebergOrgs: Listing<String>? = null
  host: String = "codeberg.org"
}

class RunnerFileEnvTarget {
  env: String
  instances: Listing<String>
}

class EncryptedSecret {
  source: Source
  env: Listing<String> = new {}
  sync: SyncTarget? = null
  runnerFileEnv: Listing<RunnerFileEnvTarget> = new {}
  dockerRegistry: String? = null
  coprFile: String? = null
}

class PlainSecret {
  source: String
  value: String
  sync: SyncTarget? = null
}

class EnvRegistry {
  encrypted: Mapping<String, EncryptedSecret> = new {}
  plain: Mapping<String, PlainSecret> = new {}
}

scopes: Mapping<String, EnvRegistry> = new {}

canPersonalPcEnv: EnvRegistry? = null
sharedPersonalPcEnv: EnvRegistry? = null
